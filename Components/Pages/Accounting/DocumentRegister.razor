@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.Text
@inject AccountingService AccountingService
@inject IWebHostEnvironment Environment
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a href="/accounting" class="back-link"><i class="bi bi-arrow-left"></i> Contabilitate</a>
        <h1 class="mt-2">@Title</h1>
        <p class="text-muted mb-0">@Subtitle</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenForm"><i class="bi bi-plus-lg me-1"></i> @AddLabel</button>
</div>

<div class="register-toolbar mb-4">
    <div class="register-search">
        <i class="bi bi-search"></i>
        <input type="search" class="form-control" placeholder="Caută după număr, furnizor sau articol..." @bind="searchTerm" @bind:event="oninput" />
        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <button type="button" class="register-search-clear" @onclick="ClearFilters" aria-label="Șterge căutarea"><i class="bi bi-x"></i></button>
        }
    </div>
    <div class="register-filter">
        <i class="bi bi-calendar3"></i>
        <InputDate @bind-Value="dateFrom" class="form-control" aria-label="De la" />
        <span>—</span>
        <InputDate @bind-Value="dateTo" class="form-control" aria-label="Până la" />
    </div>
    <button type="button" class="btn btn-filter-reset" @onclick="ClearFilters"><i class="bi bi-arrow-counterclockwise me-1"></i> Resetează</button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (showForm)
{
    <div class="accounting-form mb-4">
        <EditForm Model="draft" OnValidSubmit="Save">
        <div class="form-section-card form-section-document">
        <div class="form-section-heading">
            <span class="form-section-icon"><i class="bi bi-file-earmark-text"></i></span>
            <div><h3>@(IsEditing ? $"Editează {Title.ToLowerInvariant()}" : (DocumentType == AccountingDocumentType.ReceptionNote ? "NIR nou" : AddLabel))</h3><span>Datele principale ale documentului</span></div>
        </div>
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" />
            <div class="row g-3">
                <div class="@(DocumentType == AccountingDocumentType.ReceptionNote ? "col-md-4" : "col-md-3")">
                    <label class="form-label">Număr document</label>
                    <InputText @bind-Value="draft.Number" class="form-control" />
                    <ValidationMessage For="@(() => draft.Number)" />
                </div>
                <div class="@(DocumentType == AccountingDocumentType.ReceptionNote ? "col-md-4" : "col-md-3")"><label class="form-label">Data</label><InputDate @bind-Value="draft.DocumentDate" class="form-control" /></div>
                @if (DocumentType != AccountingDocumentType.ReceptionNote)
                {
                    <div class="col-md-3">
                        <label class="form-label">Furnizor / beneficiar</label>
                        <InputText @bind-Value="draft.PartnerName" class="form-control" />
                        <ValidationMessage For="@(() => draft.PartnerName)" />
                    </div>
                }
                @if (DocumentType != AccountingDocumentType.ReceptionNote)
                {
                    <div class="col-md-3"><label class="form-label">TVA (%)</label><InputNumber @bind-Value="draft.VatRate" class="form-control" step="0.01" min="0" /></div>
                }
            </div>
        </div>

            @if (DocumentType == AccountingDocumentType.ReceptionNote)
            {
                <div class="form-section-card form-section-reception mt-4">
                <div class="form-section-heading">
                    <span class="form-section-icon"><i class="bi bi-card-list"></i></span>
                    <div><h3>Date NIR și recepție</h3><span>Informații despre proveniență și documentele recepției</span></div>
                </div>
                <div class="nir-fields">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">Unitatea</label><InputText @bind-Value="draft.UnitName" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">Materiale furnizate de</label><InputText @bind-Value="draft.PartnerName" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">Din</label><InputText @bind-Value="draft.ReceiptSource" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">Vagon / auto nr.</label><InputText @bind-Value="draft.VehicleNumber" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Documente însoțitoare</label><InputText @bind-Value="draft.AccompanyingDocuments" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Delegat</label><InputText @bind-Value="draft.DelegateName" class="form-control" /></div>
                    </div>
                </div>
                <div class="mt-3">
                    <label class="form-label">Facturi și poze atașate</label>
                    <InputFile OnChange="OnFilesSelected" multiple accept="image/*,.pdf" />
                    <small class="text-muted d-block mt-1">Poți încărca fotografii HEIC/JPG/PNG sau PDF-uri. Maximum 10 MB / fișier.</small>
                    @if (selectedFiles.Count > 0)
                    {
                        <div class="attachment-list mt-2">@foreach (var file in selectedFiles) { <span><i class="bi bi-paperclip"></i> @file.Name</span> }</div>
                    }
                </div>
                </div>
            }

            <div class="form-section-card form-section-ingredients mt-4">
            <div class="form-section-heading">
                <span class="form-section-icon"><i class="bi bi-basket2"></i></span>
                <div><h3>Ingrediente și valori</h3><span>Adaugă materialele recepționate și valorile lor</span></div>
            </div>
            <div class="accounting-line-editor">
                <div class="accounting-import-toolbar mb-3">
                    <div>
                        <strong>Importă rânduri din CSV</strong>
                        <small class="d-block text-muted">Formatul NIR exportat cu separator „;” și zecimale cu virgulă este recunoscut automat.</small>
                    </div>
                    <label class="btn btn-outline-primary mb-0">
                        <i class="bi bi-filetype-csv me-1"></i> Alege CSV
                        <InputFile OnChange="ImportCsv" accept=".csv,text/csv" />
                    </label>
                </div>
                @if (!string.IsNullOrWhiteSpace(importMessage))
                {
                    <div class="alert @(importIsError ? "alert-danger" : "alert-success") py-2">@importMessage</div>
                }
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Ingredient</label>
                        <div class="ingredient-picker">
                            <button type="button" class="ingredient-picker-toggle" @onclick="ToggleIngredientPicker">
                                <i class="bi bi-search"></i>
                                <span>@SelectedIngredientLabel</span>
                                <i class="bi bi-chevron-down ingredient-picker-chevron"></i>
                            </button>
                            @if (ingredientPickerOpen)
                            {
                                <div class="ingredient-picker-menu">
                                    <div class="ingredient-picker-search">
                                        <i class="bi bi-search"></i>
                                        <input type="search" class="form-control" placeholder="Caută ingredient..." @bind="ingredientSearch" @bind:event="oninput" @onclick:stopPropagation />
                                        @if (!string.IsNullOrWhiteSpace(ingredientSearch))
                                        {
                                            <button type="button" @onclick="ClearIngredientSearch" aria-label="Șterge căutarea"><i class="bi bi-x"></i></button>
                                        }
                                    </div>
                                    <div class="ingredient-picker-options">
                                        @if (!FilteredIngredients.Any())
                                        {
                                            <div class="ingredient-picker-empty">Nu există ingrediente.</div>
                                        }
                                        else
                                        {
                                            @foreach (var ingredient in FilteredIngredients)
                                            {
                                                <button type="button" class="ingredient-picker-option @(selectedIngredientId == ingredient.Id.ToString() ? "selected" : string.Empty)" @onclick="() => SelectIngredient(ingredient)">
                                                    <span>@ingredient.Name</span>
                                                    @if (selectedIngredientId == ingredient.Id.ToString())
                                                    {
                                                        <i class="bi bi-check2"></i>
                                                    }
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-3"><label class="form-label">Descriere</label><input class="form-control" @bind="lineDescription" /></div>
                    <div class="col-md-2"><label class="form-label">Cantitate</label><input type="number" min="0.001" step="0.001" class="form-control" @bind="lineQuantity" /></div>
                    <div class="col-md-2"><label class="form-label">Preț unitar fără TVA</label><input type="number" min="0" step="0.01" class="form-control" @bind="linePurchaseUnitPrice" /></div>
                    <div class="col-md-1"><button type="button" class="btn btn-secondary w-100" @onclick="AddLine"><i class="bi bi-plus"></i></button></div>
                </div>
                @if (DocumentType == AccountingDocumentType.ReceptionNote)
                {
                    <div class="row g-2 mt-2">
                        <div class="col-md-4"><label class="form-label">Valoare totală vânzare</label><input type="number" min="0" step="0.01" class="form-control" @bind="lineSaleTotalValue" /></div>
                        <div class="col-md-4"><label class="form-label">TVA (%)</label><input type="number" min="0" step="0.01" class="form-control" @bind="lineVatRate" /></div>
                    </div>
                }
            </div>
            <div class="table-responsive mt-3">
            <table class="table table-sm accounting-document-lines">
                <thead>
                    <tr class="accounting-group-header">
                        <th rowspan="2">Nr. crt.</th>
                        <th rowspan="2">Material</th>
                        <th rowspan="2">U/M</th>
                        <th rowspan="2">Cant.</th>
                        <th colspan="2">Achiziție fără TVA</th>
                        <th colspan="1">Vânzare</th>
                        <th colspan="3">TVA</th>
                        <th rowspan="2"></th>
                    </tr>
                    <tr class="accounting-column-header">
                        <th>Preț unitar</th>
                        <th>Valoare</th>
                        <th>Valoare totală</th>
                        <th>Cotă</th>
                        <th>Plătită</th>
                        <th>Totală</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var indexedLine in draft.Lines.Select((line, index) => new { line, index }))
                    {
                        <tr>
                            <td class="accounting-row-number">@(indexedLine.index + 1)</td>
                            <td><input class="form-control accounting-row-input" @bind="indexedLine.line.Description" /></td>
                            <td><input class="form-control accounting-row-input accounting-row-unit" @bind="indexedLine.line.Unit" /></td>
                            <td><input type="number" min="0.001" step="0.001" class="form-control accounting-row-input" @bind="indexedLine.line.Quantity" @bind:after="() => RecalculateLine(indexedLine.line)" /></td>
                            <td><input type="number" min="0" step="0.0001" class="form-control accounting-row-input" @bind="indexedLine.line.PurchaseUnitPrice" @bind:after="() => RecalculateLine(indexedLine.line)" /></td>
                            <td>@indexedLine.line.PurchaseValue.ToString("N2") lei</td>
                            <td><input type="number" min="0" step="0.01" class="form-control accounting-row-input" @bind="indexedLine.line.SaleTotalValue" /></td>
                            <td><input type="number" min="0" step="0.01" class="form-control accounting-row-input" @bind="indexedLine.line.VatRate" @bind:after="() => RecalculateLine(indexedLine.line)" /></td>
                            <td>@indexedLine.line.VatPaidValue.ToString("N2") lei</td>
                            <td>@indexedLine.line.VatTotalValue.ToString("N2") lei</td>
                            <td class="accounting-actions-cell">
                                <button type="button" class="accounting-delete-button" title="Șterge articolul" aria-label="Șterge articolul" @onclick="() => draft.Lines.Remove(indexedLine.line)">
                                    <i class="bi bi-trash3"></i>
                                    <span>Șterge</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th colspan="9" class="text-end">Net:</th><th>@draft.NetTotal.ToString("N2") lei</th><th></th></tr>
                    <tr><th colspan="9" class="text-end">TVA totală:</th><th>@draft.VatAmount.ToString("N2") lei</th><th></th></tr>
                    <tr class="document-lines-grand-total"><th colspan="9" class="text-end">Total:</th><th>@draft.Total.ToString("N2") lei</th><th></th></tr>
                </tfoot>
            </table>
            </div>
            </div>
            <div class="form-section-card form-section-notes mt-4">
                <div class="form-section-heading">
                    <span class="form-section-icon"><i class="bi bi-chat-left-text"></i></span>
                    <div><h3>Observații</h3><span>Note suplimentare despre document</span></div>
                </div>
                <InputTextArea @bind-Value="draft.Notes" class="form-control" rows="3" />
            </div>
            @if (DocumentType == AccountingDocumentType.ReceptionNote)
            {
                <div class="form-section-card form-section-commission mt-4">
                    <div class="form-section-heading">
                        <span class="form-section-icon"><i class="bi bi-pen"></i></span>
                        <div><h3>Comisia de recepție</h3><span>Confirmarea recepției și primirea în gestiune</span></div>
                    </div>
                <div class="nir-fields">
                    <div class="nir-fields-title"><i class="bi bi-pen"></i> Comisia de recepție și primirea în gestiune</div>
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">Membru comisie</label><InputText @bind-Value="draft.CommissionMemberOne" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Primit în gestiune de</label><InputText @bind-Value="draft.WarehouseReceiverName" class="form-control" /></div>
                    </div>
                </div>
                </div>
            }
            <div class="form-actions">
            <button type="submit" class="btn btn-primary mt-3" disabled="@saving">
                @if (saving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Se salvează...</span>
                }
                else
                {
                    <span><i class="bi bi-check2 me-1"></i>Salvează</span>
                }
            </button>
            <button type="button" class="btn btn-secondary mt-3 ms-2" @onclick="() => showForm = false">Anulează</button>
            </div>
        </EditForm>
    </div>
}

<div class="card register-card">
    <div class="register-card-header">
        <div>
            <h3 class="mb-1">Registru @Title.ToLowerInvariant()</h3>
            <span class="text-muted small">@(FilteredDocuments.Count()) din @documents.Count documente afișate</span>
        </div>
        <span class="register-total"><strong>@FilteredDocuments.Count()</strong> rezultate</span>
    </div>
    @if (!FilteredDocuments.Any())
    {
        <div class="empty-state">
            <i class="bi @(documents.Any() ? "bi-search" : "bi-journal-x")"></i>
            <p>@(documents.Any() ? "Nu există documente care corespund filtrelor." : "Nu există documente înregistrate.")</p>
            @if (documents.Any()) { <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearFilters">Șterge filtrele</button> }
        </div>
    }
    else
    {
        <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Data</th><th>Număr</th><th>Partener</th><th>Articole</th><th>TVA</th><th>Total</th><th>Atașamente</th><th></th></tr></thead><tbody>
        @foreach (var document in FilteredDocuments)
        {
            <tr class="document-row" @onclick="() => OpenDetails(document.Id)">
                <td><span class="document-date">@document.DocumentDate.ToString("dd.MM.yyyy")</span></td>
                <td class="fw-bold"><a href="@GetDetailsUrl(document.Id)" @onclick:stopPropagation>@document.Number</a></td>
                <td>@document.PartnerName</td>
                <td>@document.Lines.Count</td>
                <td>@(document.Type == AccountingDocumentType.ReceptionNote ? "Pe produse" : $"{document.VatRate:N2}%")</td>
                <td class="fw-bold">@document.Total.ToString("N2") lei</td>
                <td>
                    @if (document.Attachments.Count == 0)
                    {
                        <span class="text-muted">-</span>
                    }
                    else
                    {
                        <span class="attachment-count"><i class="bi bi-paperclip"></i> @document.Attachments.Count</span>
                    }
                </td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-primary me-1" title="Editează" @onclick:stopPropagation @onclick="() => EditDocument(document)"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-sm btn-outline-danger" title="Șterge" @onclick:stopPropagation @onclick="() => Delete(document)"><i class="bi bi-trash"></i></button>
                </td>
            </tr>
        }
        </tbody></table></div>
    }
</div>

@code {
    [Parameter] public AccountingDocumentType DocumentType { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string AddLabel { get; set; } = "Document nou";
    [Parameter] public Guid? EditId { get; set; }

    private List<AccountingDocument> documents = new();
    private List<Ingredient> ingredients = new();
    private AccountingDocument draft = new();
    private List<IBrowserFile> selectedFiles = new();
    private string? errorMessage;
    private bool showForm;
    private bool saving;
    private string? importMessage;
    private bool importIsError;
    private string selectedIngredientId = string.Empty;
    private string lineDescription = string.Empty;
    private decimal lineQuantity = 1;
    private decimal linePurchaseUnitPrice;
    private decimal lineSaleTotalValue;
    private decimal lineVatRate = 11m;
    private string ingredientSearch = string.Empty;
    private bool ingredientPickerOpen;
    private string searchTerm = string.Empty;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private bool IsEditing => EditId.HasValue;
    private decimal CalculatedLineVat => linePurchaseUnitPrice * lineQuantity * lineVatRate / 100m;

    private IEnumerable<Ingredient> FilteredIngredients =>
        ingredients.Where(ingredient =>
            string.IsNullOrWhiteSpace(ingredientSearch)
            || ingredient.Name.Contains(ingredientSearch, StringComparison.OrdinalIgnoreCase));

    private string SelectedIngredientLabel =>
        ingredients.FirstOrDefault(ingredient => ingredient.Id.ToString() == selectedIngredientId)?.Name
        ?? $"Alege ingredientul ({FilteredIngredients.Count()})";

    private IEnumerable<AccountingDocument> FilteredDocuments =>
        documents
            .Where(document => !dateFrom.HasValue || document.DocumentDate.Date >= dateFrom.Value.Date)
            .Where(document => !dateTo.HasValue || document.DocumentDate.Date <= dateTo.Value.Date)
            .Where(document =>
                string.IsNullOrWhiteSpace(searchTerm)
                || document.Number.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                || document.PartnerName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                || document.Lines.Any(line => line.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                    || line.Ingredient?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true));

    protected override async Task OnInitializedAsync()
    {
        ingredients = await AccountingService.GetIngredientsAsync();
        await Reload();

        if (EditId.HasValue)
        {
            var existing = await AccountingService.GetDocumentByIdAsync(EditId.Value);
            if (existing is null || existing.Type != DocumentType)
            {
                errorMessage = "Documentul nu a fost găsit.";
                return;
            }

            draft = existing;
            if (DocumentType == AccountingDocumentType.ReceptionNote)
            {
                draft.VehicleNumber = "DJ 22 BJB";
                draft.DelegateName = "BLAGA CIPRIAN";
            }
            if (DocumentType == AccountingDocumentType.ReceptionNote && string.IsNullOrWhiteSpace(draft.InvoiceNumber))
            {
                draft.InvoiceNumber = draft.AccompanyingDocumentNumber;
                draft.AccompanyingDocumentNumber = null;
            }
            showForm = true;
        }
    }
    private async Task Reload() => documents = await AccountingService.GetDocumentsAsync(DocumentType);
    private void OpenForm() { errorMessage = null; importMessage = null; draft = new AccountingDocument { Type = DocumentType, Number = string.Empty, VatRate = 11m, UnitName = DocumentType == AccountingDocumentType.ReceptionNote ? "BJB CATERING FOOD SRL" : string.Empty, VehicleNumber = DocumentType == AccountingDocumentType.ReceptionNote ? "DJ 22 BJB" : string.Empty, DelegateName = DocumentType == AccountingDocumentType.ReceptionNote ? "BLAGA CIPRIAN" : string.Empty }; selectedFiles.Clear(); ingredientSearch = string.Empty; selectedIngredientId = string.Empty; ingredientPickerOpen = false; ResetLineFields(); showForm = true; }
    private void EditDocument(AccountingDocument document) => NavigationManager.NavigateTo(GetEditUrl(document));
    private string GetEditUrl(AccountingDocument document) => document.Type switch
    {
        AccountingDocumentType.ReceptionNote => $"/accounting/document/edit/{document.Id}",
        AccountingDocumentType.ConsumptionNote => $"/accounting/consumption-note/edit/{document.Id}",
        AccountingDocumentType.FiscalReceipt => $"/accounting/fiscal-receipt/edit/{document.Id}",
        _ => $"/accounting/document/edit/{document.Id}"
    };
    private void ClearIngredientSearch() => ingredientSearch = string.Empty;
    private void ToggleIngredientPicker() => ingredientPickerOpen = !ingredientPickerOpen;
    private void SelectIngredient(Ingredient ingredient)
    {
        selectedIngredientId = ingredient.Id.ToString();
        ingredientSearch = string.Empty;
        ingredientPickerOpen = false;
    }
    private void ClearFilters() { searchTerm = string.Empty; dateFrom = null; dateTo = null; }
    private void OnFilesSelected(InputFileChangeEventArgs args) => selectedFiles = args.GetMultipleFiles(30).ToList();
    private async Task ImportCsv(InputFileChangeEventArgs args)
    {
        importMessage = null;
        importIsError = false;

        var file = args.File;
        if (file is null || !file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            importIsError = true;
            importMessage = "Selectează un fișier CSV valid.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            var content = await reader.ReadToEndAsync();
            var importedLines = ParseCsvLines(content);

            if (importedLines.Count == 0)
            {
                importIsError = true;
                importMessage = "CSV-ul nu conține rânduri de produse recunoscute.";
                return;
            }

            draft.Lines.Clear();
            foreach (var line in importedLines)
            {
                draft.Lines.Add(line);
            }

            importMessage = $"Au fost importate {importedLines.Count} rânduri din „{file.Name}”. Verifică datele înainte de salvare.";
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or FormatException)
        {
            importIsError = true;
            importMessage = $"Importul CSV a eșuat: {exception.Message}";
        }
    }

    private static List<AccountingDocumentLine> ParseCsvLines(string content)
    {
        var rows = content
            .Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(ParseCsvRow)
            .Where(row => row.Count > 0)
            .ToList();

        if (rows.Count < 2)
        {
            return new List<AccountingDocumentLine>();
        }

        var headers = rows[0]
            .Select(NormalizeCsvHeader)
            .ToList();
        var result = new List<AccountingDocumentLine>();

        for (var rowIndex = 1; rowIndex < rows.Count; rowIndex++)
        {
            var row = rows[rowIndex];
            if (row.Count == 0 || string.IsNullOrWhiteSpace(GetCsvValue(row, headers, "material")))
            {
                continue;
            }

            var quantity = ParseCsvDecimal(GetCsvValue(row, headers, "cant", "cantitate"));
            var purchaseUnitPrice = ParseCsvDecimal(GetCsvValue(row, headers, "achizițiefărătvaprețunitar"));
            var importedPurchaseValue = ParseCsvDecimal(GetCsvValue(row, headers, "achizițiefărătvavaloare"));
            var purchaseValue = importedPurchaseValue > 0
                ? importedPurchaseValue
                : Math.Round(quantity * purchaseUnitPrice, 2, MidpointRounding.AwayFromZero);
            var saleTotalValue = ParseCsvDecimal(GetCsvValue(row, headers, "vânzarevaloaretotală"));
            var importedVatPaidValue = ParseCsvDecimal(GetCsvValue(row, headers, "tvaplatită"));
            var importedVatTotalValue = ParseCsvDecimal(GetCsvValue(row, headers, "tvatotală"));
            var vatTotalValue = importedVatTotalValue > 0
                ? importedVatTotalValue
                : Math.Round(purchaseValue + importedVatPaidValue, 2, MidpointRounding.AwayFromZero);
            var vatPaidValue = importedVatTotalValue > 0
                ? Math.Round(vatTotalValue - purchaseValue, 2, MidpointRounding.AwayFromZero)
                : importedVatPaidValue;
            var vatRate = purchaseValue > 0
                ? Math.Round(vatPaidValue / purchaseValue * 100m, 2, MidpointRounding.AwayFromZero)
                : 11m;

            result.Add(new AccountingDocumentLine
            {
                Description = GetCsvValue(row, headers, "material"),
                Unit = GetCsvValue(row, headers, "u/m", "um", "unitate"),
                Quantity = quantity,
                UnitPrice = purchaseUnitPrice,
                PurchaseUnitPrice = purchaseUnitPrice,
                PurchaseValue = purchaseValue,
                SaleTotalValue = saleTotalValue,
                VatRate = vatRate,
                VatPaidValue = vatPaidValue,
                VatTotalValue = vatTotalValue > 0 ? vatTotalValue : purchaseValue + vatPaidValue
            });
        }

        return result;
    }

    private static string GetCsvValue(IReadOnlyList<string> row, IReadOnlyList<string> headers, params string[] names)
    {
        foreach (var name in names)
        {
            var index = headers
                .Select((header, headerIndex) => new { header, headerIndex })
                .FirstOrDefault(item => item.header == NormalizeCsvHeader(name))?.headerIndex ?? -1;
            if (index >= 0 && index < row.Count)
            {
                return row[index].Trim();
            }
        }

        return string.Empty;
    }

    private static decimal ParseCsvDecimal(string value)
    {
        var normalized = value.Trim().Replace(" lei", string.Empty, StringComparison.OrdinalIgnoreCase).Replace(" ", string.Empty);
        if (decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.GetCultureInfo("ro-RO"), out var romanianValue))
        {
            return romanianValue;
        }

        return decimal.TryParse(normalized.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var invariantValue)
            ? invariantValue
            : 0m;
    }

    private static List<string> ParseCsvRow(string line)
    {
        var values = new List<string>();
        var current = new StringBuilder();
        var quoted = false;

        for (var index = 0; index < line.Length; index++)
        {
            var character = line[index];
            if (character == '"')
            {
                if (quoted && index + 1 < line.Length && line[index + 1] == '"')
                {
                    current.Append('"');
                    index++;
                }
                else
                {
                    quoted = !quoted;
                }
            }
            else if (character == ';' && !quoted)
            {
                values.Add(current.ToString());
                current.Clear();
            }
            else
            {
                current.Append(character);
            }
        }

        values.Add(current.ToString());
        return values;
    }

    private static string NormalizeCsvHeader(string value)
    {
        var normalized = value.Trim().Trim('\uFEFF').ToLowerInvariant();
        var builder = new StringBuilder(normalized.Length);
        foreach (var character in normalized)
        {
            if (char.IsLetterOrDigit(character))
            {
                builder.Append(character);
            }
        }

        return builder.ToString();
    }
    private void AddLine()
    {
        if (lineQuantity <= 0) { errorMessage = "Cantitatea trebuie să fie mai mare decât zero."; return; }
        var ingredient = ingredients.FirstOrDefault(item => item.Id.ToString() == selectedIngredientId);
        var purchaseValue = linePurchaseUnitPrice * lineQuantity;
        var lineVat = purchaseValue * lineVatRate / 100m;
        draft.Lines.Add(new AccountingDocumentLine
        {
            IngredientId = ingredient?.Id, Ingredient = ingredient,
            Description = string.IsNullOrWhiteSpace(lineDescription) ? ingredient?.Name ?? "Articol" : lineDescription,
            Quantity = lineQuantity, UnitPrice = linePurchaseUnitPrice,
            PurchaseUnitPrice = linePurchaseUnitPrice, PurchaseValue = purchaseValue,
            SaleTotalValue = lineSaleTotalValue,
            VatRate = lineVatRate, VatPaidValue = lineVat, VatTotalValue = purchaseValue + lineVat
        });
        selectedIngredientId = string.Empty; ResetLineFields();
    }
    private void RecalculateLine(AccountingDocumentLine line)
    {
        line.PurchaseValue = line.PurchaseUnitPrice * line.Quantity;
        line.VatPaidValue = line.PurchaseValue * line.VatRate / 100m;
        line.VatTotalValue = line.PurchaseValue + line.VatPaidValue;
    }
    private void ResetLineFields() { lineDescription = string.Empty; lineQuantity = 1; linePurchaseUnitPrice = 0; lineSaleTotalValue = 0; lineVatRate = 11m; }
    private async Task Save()
    {
        errorMessage = null;
        saving = true;
        try
        {
            if (draft.Lines.Count == 0)
            {
                errorMessage = "Adaugă cel puțin un articol înainte de salvare.";
                return;
            }

            foreach (var line in draft.Lines)
            {
                RecalculateLine(line);
            }

            var uploadDirectory = Path.Combine(Environment.WebRootPath, "uploads", "invoices");
            Directory.CreateDirectory(uploadDirectory);
            foreach (var file in selectedFiles)
            {
                var storedName = $"{Guid.NewGuid():N}{Path.GetExtension(file.Name)}";
                await using var memory = new MemoryStream();
                await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(memory);
                var fileData = memory.ToArray();

                await using var stream = File.Create(Path.Combine(uploadDirectory, storedName));
                await stream.WriteAsync(fileData);
                draft.Attachments.Add(new AccountingDocumentAttachment
                {
                    OriginalFileName = file.Name,
                    StoredFileName = storedName,
                    ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    FileData = fileData
                });
            }
            if (IsEditing)
            {
                await AccountingService.UpdateDocumentAsync(draft);
                NavigationManager.NavigateTo($"/accounting/document/{draft.Id}");
            }
            else
            {
                await AccountingService.AddDocumentAsync(draft);
                showForm = false;
                await Reload();
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            errorMessage = $"Documentul nu a putut fi salvat: {ex.GetBaseException().Message}";
        }
        finally
        {
            saving = false;
        }
    }
    private async Task Delete(AccountingDocument document) { await AccountingService.DeleteDocumentAsync(document.Id); await Reload(); }
    private string GetDetailsUrl(Guid id) => $"/accounting/document/{id}";
    private void OpenDetails(Guid id) => NavigationManager.NavigateTo(GetDetailsUrl(id));
}
